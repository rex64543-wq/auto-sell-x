# ==========================================
# Discord Auto Sell Bot Configuration
# ==========================================

# Required: Get these from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_BOT_CLIENT_ID_HERE

# Recommended for instant slash command registration (Your Discord Server ID)
# Right click your server icon in Discord -> Copy Server ID (Developer Mode must be enabled)
GUILD_ID=YOUR_DISCORD_SERVER_ID_HERE

# Optional Default APIs (can also be configured per-product via /product command)
KEYAUTH_SELLER_KEY=
CUSTOM_API_URL=
